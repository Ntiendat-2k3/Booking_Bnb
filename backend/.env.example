# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# DB (Sequelize)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airbnb_app
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
DB_SSL=false

# JWT
JWT_SECRET=change_me_single_secret
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=30d

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Cookies
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_CSRF_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_TOKEN_EXPIRES=12h

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Booking BnB" <noreply@example.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (cache)
REDIS_DISABLED=false
CACHE_ENABLED=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_PREFIX=cache
CACHE_MAX_BYTES=1048576

# Booking cleanup
BOOKING_HOLD_MINUTES=15
